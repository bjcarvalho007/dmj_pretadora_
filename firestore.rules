rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis e cadastros de Usuários
    match /users/{userId} {
      allow read, write: if true;
    }

    // Avaliações / Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Serviços prestados pela DMJ
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Devis / Orçamentos / Solicitações de clientes
    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    // Regra fallback para qualquer coleção
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

