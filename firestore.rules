rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Avaliações / Reviews
    match /reviews/{reviewId} {
      // Leitura pública para que os visitantes vejam os depoimentos no site
      allow read: if true;
      
      // Permitir envio de novas avaliações validando campos essenciais
      allow create: if request.resource.data.author is string 
                    && request.resource.data.comment is string;
                    
      // Alteração e exclusão apenas por usuários autenticados
      allow update, delete: if request.auth != null;
    }

    // Serviços prestados pela DMJ
    match /services/{serviceId} {
      // Leitura pública do catálogo de serviços
      allow read: if true;
      
      // Alteração/Criação/Exclusão restrita a usuários autenticados
      allow write: if request.auth != null;
    }

    // Perfil dos Usuários
    match /users/{userId} {
      // Apenas o próprio usuário autenticado pode ler ou editar seu perfil
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
